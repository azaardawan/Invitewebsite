# Copy to .env and fill in. Never commit real values.

# development | staging | production
APP_ENV=development
# Public base URL of the site (no trailing slash)
APP_URL=http://localhost:3000

DATABASE_URL=postgres://bahja:bahja@localhost:5432/bahja_dev
# Used only by the test suite
TEST_DATABASE_URL=postgres://bahja:bahja@localhost:5432/bahja_test

# 32 random bytes, base64. Encrypts admin 2FA secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# 32 random bytes, base64. Derives private receipt links. Never rotate unless compromised.
TOKEN_SECRET=

# Random string. Salts IP hashes in logs (raw IPs are never stored).
IP_HASH_SALT=

# File storage. `local` (development) writes to LOCAL_STORAGE_DIR and serves /media/*.
# Staging/production use Cloudflare R2 (S3-compatible) behind a CDN domain.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=bahja-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=https://media.example.com

# WAYL payments. Without WAYL_API_KEY, checkout creates the order and payment is collected manually.
# WAYL_API_KEY=
# WAYL_API_BASE_URL=https://api.thewayl.com
# `test` = WAYL test-mode links (no real money). Production requires `live`.
# WAYL_ENV=test
# Shared secret for the scheduled payment reconciliation call (32+ characters).
# CRON_SECRET=

# Optional: Cloudflare Turnstile on the guest form (set both, or neither).
# WhatsApp message to the owner for every paid order (via CallMeBot). Both or neither.
# OWNER_WHATSAPP_PHONE=+9647xxxxxxxxx
# CALLMEBOT_API_KEY=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# PDFs (printable card, keepsake): Chromium path (defaults to Playwright's) and where it reaches the print pages.
# CHROMIUM_PATH=/usr/bin/chromium
# PRINT_ORIGIN=http://127.0.0.1:3000
