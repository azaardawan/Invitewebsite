# Copy to .env and fill in. Never commit real values.

# development | staging | production
APP_ENV=development
# Public base URL of the site (no trailing slash)
APP_URL=http://localhost:3000

DATABASE_URL=postgres://bahja:bahja@localhost:5432/bahja_dev
# Used only by the test suite
TEST_DATABASE_URL=postgres://bahja:bahja@localhost:5432/bahja_test

# 32 random bytes, base64. Encrypts admin 2FA secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Random string. Salts IP hashes in logs (raw IPs are never stored).
IP_HASH_SALT=
